# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/zhizi"

# Cloudflare R2 (S3 兼容)
# endpoint 格式: https://{account-id}.r2.cloudflarestorage.com
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="zhizi-records"

# 用户标识加盐哈希的盐（HMAC key）。必须稳定持久：一旦更换，已存在的账号将无法定位自己的数据。
# 生成方式示例: openssl rand -hex 32
USER_HASH_SALT="change-me-to-a-long-random-string"
