# 复制此文件为 .env.local 并填入真实的配置值
# cp .env.local.example .env.local
#
# Next.js 加载优先级: .env.local > .env
# 开发时推荐使用 .env.local 存放本地配置

# Database (PostgreSQL via Neon)
DATABASE_URL="postgresql://user:password@host:5432/database"

# Cloudflare R2 (S3 兼容)
# endpoint 格式: https://{account-id}.r2.cloudflarestorage.com
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="zhizi-records"

# SSH 远程连接配置
# SSH 连接超时时间（毫秒），默认 30000
SSH_CONNECT_TIMEOUT=30000
