generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Record {
  id        String   @id @default(cuid())
  userHash  String
  fileName  String
  fileKey   String   @unique
  fileSize  Int
  gameInfo  Json?
  createdAt DateTime @default(now())

  @@index([userHash])
}
